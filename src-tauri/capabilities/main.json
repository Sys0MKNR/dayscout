{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-perms",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA"
        }
      ]
    },
    "store:default",
    "autostart:default",
    "log:default"
  ]
}
